# Variables locales; reemplaza estos valores en tu gestor de secretos. No uses este archivo para producción.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Crear la cuenta inicial una sola vez
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CAMBIA_POR_UNA_CONTRASENA_DE_AL_MENOS_20_CARACTERES
JWT_SECRET=CAMBIA_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_64_CARACTERES

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Origen del frontend local
FRONTEND_ORIGIN=http://localhost:3001
VITE_AUTH_API_BASE_URL=http://localhost:3000
FRONTEND_PORT=3001
BACKEND_PORT=3000
RUN_MIGRATIONS=true
